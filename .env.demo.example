# Template for Render. Copy to gitignored .env.demo or paste into the dashboard.
# Frontends bake in VITE_API_TOKEN=cant_change — API_TOKEN must match.

APP_ENV=demo
NODE_ENV=production
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ecom_pos
JWT_SECRET=change-me
API_TOKEN=cant_change
CORS_ORIGINS=*.vercel.app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
